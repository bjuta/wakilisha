[Unit]
Description=WAKILISHA WK100 Governed Source Scheduler Tick
Documentation=https://github.com/bjuta/wakilisha/issues/1338
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Hosted JWT verification remains authoritative. No secret in arguments/env/journal.
Environment=WK100_SCHEDULER_PROJECT_REF=pgzizndxdyhqmtyywjmt
LoadCredential=wk100_service_jwt:/etc/wakilisha-wk100-source-scheduler.jwt
ExecStart=/usr/bin/python3 -I -B /opt/wakilisha-wk100-source-scheduler/trigger.py
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=128M
TasksMax=32
TimeoutStartSec=180s
StandardOutput=journal
StandardError=journal

[Install]
# Deliberately no WantedBy: only the separately approved timer is enabled.
