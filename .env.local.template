# WAKILISHA Chart V2 Dev Environment
# Copy this to .env.local and fill in your values.
#
# Required for database mode (default):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
WAKILISHA_V2_REPOSITORY_MODE=database
WAKILISHA_V2_API_PORT=4176

# Frontend env vars (injected by the dev script, but can be overridden here)
# Dev mode always hits the Vite proxy path:
VITE_CHARTS_PUBLIC_MODE=wordpress
VITE_CHARTS_PUBLIC_API_VERSION=v2
VITE_WAKILISHA_WP_V2_API_BASE=/__wakilisha-v2-api/wp-json/wakilisha/v2

# Optional: run the API without a database (uses JSON files under public/charts-data)
# WAKILISHA_V2_REPOSITORY_MODE=json

# Optional: force V2 API mode even if DATABASE_URL is set
# WAKILISHA_V2_FORCE_JSON=1

# ─── Sprint 3: Provider Credentials ───────────────────────────────────────────
# Spotify Web API (Client Credentials flow — no user auth needed for public playlists)
# Create an app at https://developer.spotify.com/dashboard
# VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
# VITE_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Apple Music API
# Generate a developer token at https://developer.apple.com/account/resources
# VITE_APPLE_MUSIC_DEVELOPER_TOKEN=your_apple_developer_token

# Chart ingestion mode (mock | wordpress)
# VITE_CHARTS_INGESTION_MODE=mock
# WordPress base URL for v1 endpoints
# VITE_WAKILISHA_WP_API_BASE=/wp-json/wakilisha/v1

# Note: Without provider credentials the system uses deterministic mock data.
# The same source URL always produces the same tracks (seeded from URL hash),
# so dry run results are consistent across sessions in mock mode.