{
  "version": 1,
  "purpose": "Read-only planning contract for musical Work resolution. Provider availability never authorizes canonical mutation.",
  "defaultProfile": "work-evidence-only",
  "profiles": {
    "work-evidence-only": {
      "description": "Select only fields needed to resolve Recording identity, Work identity, and writer relationships.",
      "categories": [
        "recording_identity",
        "work_identity",
        "work_contributor"
      ]
    },
    "work-plus-registry-enrichment": {
      "description": "Work evidence plus optional Registry enrichment selected by policy.",
      "categories": [
        "recording_identity",
        "work_identity",
        "work_contributor",
        "registry_enrichment"
      ]
    },
    "review-all-available": {
      "description": "Select every policy-allowed field in the manifest for operator review. Policy-blocked fields remain excluded.",
      "categories": [
        "recording_identity",
        "work_identity",
        "work_contributor",
        "registry_enrichment",
        "provider_context"
      ]
    }
  },
  "providers": {
    "musicbrainz": {
      "label": "MusicBrainz",
      "acquisitionMode": "public_or_commercial_api",
      "workEvidenceStrength": "strong",
      "policyStatus": "allowed_with_service_terms",
      "policyNote": "Public web service is free for non-commercial use and rate-limited. Commercial use requires an appropriate commercial arrangement or licensed data path.",
      "docs": [
        "https://musicbrainz.org/doc/MusicBrainz_API",
        "https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting"
      ],
      "fields": [
        {
          "key": "isrc",
          "category": "recording_identity",
          "defaultSelected": true,
          "retention": "retain",
          "description": "Recording identity lookup key."
        },
        {
          "key": "recording_mbid",
          "category": "recording_identity",
          "defaultSelected": true,
          "retention": "retain",
          "description": "MusicBrainz Recording identity."
        },
        {
          "key": "work_mbid",
          "category": "work_identity",
          "defaultSelected": true,
          "retention": "retain",
          "description": "MusicBrainz Work identity reached through Recording to Work relationships."
        },
        {
          "key": "iswc",
          "category": "work_identity",
          "defaultSelected": true,
          "retention": "retain",
          "description": "International Standard Musical Work Code when present."
        },
        {
          "key": "work_title",
          "category": "work_identity",
          "defaultSelected": true,
          "retention": "retain",
          "description": "Title of the matched musical Work."
        },
        {
          "key": "composer_relations",
          "category": "work_contributor",
          "defaultSelected": true,
          "retention": "retain",
          "description": "Composer relationships attached to the Work."
        },
        {
          "key": "lyricist_relations",
          "category": "work_contributor",
          "defaultSelected": true,
          "retention": "retain",
          "description": "Lyricist relationships attached to the Work."
        },
        {
          "key": "writer_mbids",
          "category": "work_contributor",
          "defaultSelected": true,
          "retention": "retain",
          "description": "MusicBrainz Artist identities for Work contributors."
        },
        {
          "key": "work_language",
          "category": "registry_enrichment",
          "defaultSelected": false,
          "retention": "optional",
          "description": "Language metadata for the Work."
        },
        {
          "key": "work_type",
          "category": "registry_enrichment",
          "defaultSelected": false,
          "retention": "optional",
          "description": "MusicBrainz Work type."
        },
        {
          "key": "aliases",
          "category": "provider_context",
          "defaultSelected": false,
          "retention": "optional",
          "description": "Work aliases for review and discovery."
        },
        {
          "key": "tags",
          "category": "provider_context",
          "defaultSelected": false,
          "retention": "optional",
          "description": "Community/provider tags; never identity authority."
        }
      ]
    },
    "mlc": {
      "label": "The MLC",
      "acquisitionMode": "registered_public_api_or_bwarm",
      "workEvidenceStrength": "strong",
      "policyStatus": "allowed_with_service_terms",
      "policyNote": "The Musical Works Database may be used for lawful purposes. API and bulk access require registration.",
      "docs": [
        "https://www.themlc.com/dataprograms",
        "https://www.themlc.com/musicalworksdatabasetermsuse"
      ],
      "fields": [
        {
          "key": "isrc",
          "category": "recording_identity",
          "defaultSelected": true,
          "retention": "retain",
          "description": "Matched sound-recording identifier."
        },
        {
          "key": "work_identifier",
          "category": "work_identity",
          "defaultSelected": true,
          "retention": "retain",
          "description": "MLC musical Work identity."
        },
        {
          "key": "work_title",
          "category": "work_identity",
          "defaultSelected": true,
          "retention": "retain",
          "description": "Registered musical Work title."
        },
        {
          "key": "writers",
          "category": "work_contributor",
          "defaultSelected": true,
          "retention": "retain",
          "description": "Writer parties associated with the Work."
        },
        {
          "key": "publishers",
          "category": "registry_enrichment",
          "defaultSelected": false,
          "retention": "optional",
          "description": "Publisher/administrator information."
        },
        {
          "key": "ownership_shares",
          "category": "provider_context",
          "defaultSelected": false,
          "retention": "optional",
          "description": "Ownership-share context. Do not infer user ownership or royalties from absence/presence alone."
        },
        {
          "key": "matched_recordings",
          "category": "recording_identity",
          "defaultSelected": true,
          "retention": "retain",
          "description": "Recording-to-Work match evidence."
        },
        {
          "key": "products_releases",
          "category": "registry_enrichment",
          "defaultSelected": false,
          "retention": "optional",
          "description": "Related product/release context."
        }
      ]
    },
