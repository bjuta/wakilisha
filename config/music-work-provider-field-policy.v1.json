        {
          "key": "album",
          "category": "registry_enrichment",
          "defaultSelected": false,
          "retention": "optional",
          "description": "Album context."
        },
        {
          "key": "genres",
          "category": "provider_context",
          "defaultSelected": false,
          "retention": "optional",
          "description": "Provider genre context."
        },
        {
          "key": "release_date",
          "category": "registry_enrichment",
          "defaultSelected": false,
          "retention": "optional",
          "description": "Release date context."
        }
      ]
    },
